{
  "name": "shapebazaar-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "start:web": "npm run start --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "test": "npm run test --workspace=packages/shared",
    "test:watch": "npm run test:watch --workspace=packages/shared",
    "dev:mobile": "npm run start --workspace=apps/mobile"
  },
  "dependencies": {
    "react-native-reanimated": "^4.6.0",
    "react-native-worklets": "^0.12.2"
  }
}
