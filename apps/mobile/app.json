{
  "expo": {
    "name": "ShapeBazaar",
    "slug": "shapebazaar",
    "scheme": "shapebazaar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F8FAFC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shapebazaar.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shapebazaar.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
